{
  "name": "edge-context-router",
  "version": "0.1.0",
  "description": "Zero-latency browser AI orchestration. Evaluates input against a local graph to extract Minimum Viable Context (MVC) and intelligently routes tasks between local WebGPU models and cloud LLMs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nff747/edge-context-router.git"
  },
  "keywords": [
    "llm",
    "webllm",
    "knowledge-graph",
    "semantic-routing",
    "mvc",
    "context-engineering",
    "browser-ai",
    "orchestration"
  ],
  "author": "iKi <nff747@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
